{
  "name": "self-discipline-manager",
  "private": true,
  "version": "0.1.0",
  "description": "Local desktop tasks and reminders",
  "author": "Self Discipline Manager",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11.19.0"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json",
    "test": "node tests/run.cjs",
    "test:installed": "node tests/windows-installed.cjs",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "postinstall": "npm run verify:native",
    "verify:native": "node scripts/verify-native.cjs",
    "pack:win": "npm run verify:native && npm run build && electron-builder --win --x64 --dir",
    "build:win": "npm run verify:native && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "^0.45.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "playwright-core": "1.62.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron@44.9.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
